{
  "name": "rosemont-games",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "description": "Rosemont Games — a multi-game hub (UNO and more) on a shared core.",
  "scripts": {
    "hub": "node hub/server.js",
    "uno": "node games/uno/server.js",
    "holdem": "node games/holdem/server.js",
    "ginrummy": "node games/ginrummy/server.js",
    "dev:hub": "node --watch hub/server.js",
